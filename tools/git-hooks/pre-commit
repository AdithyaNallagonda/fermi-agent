#!/bin/sh
# Blocks commits that would publish a GitHub token: anything under .env/, any *.token file, text that looks
# like a GitHub token, or the exact token stored in .env/github.token.
# Enable once per clone:  git config core.hooksPath tools/git-hooks

root=$(git rev-parse --show-toplevel) || exit 1
fail=0

if git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(/|$)|\.token$' >/dev/null; then
  echo "pre-commit: refusing to commit files under .env/ or named *.token" >&2
  fail=1
fi

if git diff --cached -U0 --no-color | grep -E '^\+' |
   grep -E 'github_pat_[A-Za-z0-9_]{30,}|gh[pousr]_[A-Za-z0-9]{30,}' >/dev/null; then
  echo "pre-commit: staged changes contain text that looks like a GitHub token" >&2
  fail=1
fi

token_file="$root/.env/github.token"
if [ -s "$token_file" ]; then
  token=$(tr -d '\r\n' < "$token_file")
  if [ -n "$token" ] && git diff --cached -U0 --no-color | grep -F -- "$token" >/dev/null; then
    echo "pre-commit: staged changes contain your stored GitHub token" >&2
    fail=1
  fi
  token=
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: commit blocked. Remove the secret from the staged files and try again." >&2
fi
exit $fail
